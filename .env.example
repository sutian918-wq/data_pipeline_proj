# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_NAME=market_data
CONSUMER_GROUP=processors
PRODUCER_THREADS=4
CONSUMER_THREADS=3

# Kafka Producer performance tuning parameters
PRODUCER_BATCH_SIZE=16384
PRODUCER_LINGER_MS=10
PRODUCER_COMPRESSION_TYPE=lz4
PRODUCER_QUEUE_BUFFERING_MAX_KBYTES=32768

# POSTGRES configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data_pipeline
POSTGRES_USER=YOUR_USERNAME   # (or 'postgres' if you created that user)
POSTGRES_PASSWORD=YOUR_PASSWORD   # (leave empty if no password)

# Fetcher Configuration
FETCHER_TYPE=simulated
TICKERS=AAPL,GOOGL,MSFT,TSLA,AMZN,META,NVDA,NFLX,INTC,AMD

# Simulated Fetcher Settings
SIMULATED_MIN_PRICE=100
SIMULATED_MAX_PRICE=500
SIMULATED_DELAY_MIN=0.2
SIMULATED_DELAY_MAX=1.0